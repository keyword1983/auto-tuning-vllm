# Lightweight CPU-only Optuna Tuner Runner image for AFSBox Kubernetes orchestration
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    torch \
    "optuna>=3.6.0" \
    "optuna-integration[botorch]>=4.0.0" \
    "gpytorch>=1.1" \
    "kubernetes>=28.0.0" \
    "pydantic>=2.0.0" \
    "pyyaml>=6.0" \
    "typer>=0.9.0" \
    "rich>=13.0.0" \
    "requests>=2.28.0" \
    "psycopg2-binary>=2.9.0"

COPY . /app
RUN pip install --no-cache-dir --no-deps -e /app

ENTRYPOINT ["auto-tune-vllm", "optimize"]
CMD ["--help"]
